<!-- HERO -->
<section class="hero">
    <div class="container hero-grid">
        <div class="hero-text">
            <span class="eyebrow">Oficina de arte criativa para crianças</span>
            <h1>Estimulando a <span class="rainbow-text">criatividade</span> na infância</h1>
            <p>Potencialize as habilidades do seu filho de forma lúdica e divertida. Oficinas criativas a domicílio e no seu evento, em {{site.cidade}}.</p>
            <div class="hero-actions">
                <a href="{{site.contato.whatsappLink}}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">
                    <i class='bx bxl-whatsapp'></i> Agendar oficina
                </a>
                <a href="/oficinas" class="btn btn-outline btn-lg">Conhecer as oficinas</a>
            </div>
        </div>
        <div class="hero-image">
            <span class="blob blob-yellow" aria-hidden="true"></span>
            <span class="blob blob-blue" aria-hidden="true"></span>
            <div class="hero-slides" aria-roledescription="carrossel" aria-label="Fotos das oficinas">
                {{#each site.heroFotos}}
                <img src="{{src}}" alt="{{alt}}" class="hero-slide{{#if @first}} active{{/if}}" style="object-position: {{pos}}"{{#if @first}} fetchpriority="high"{{else}} aria-hidden="true" decoding="async"{{/if}}>
                {{/each}}
            </div>
            <div class="hero-dots" role="group" aria-label="Escolher foto">
                {{#each site.heroFotos}}
                <button type="button" class="hero-dot{{#if @first}} active{{/if}}" data-slide="{{@index}}" aria-label="Mostrar foto {{inc @index}}"{{#if @first}} aria-current="true"{{/if}}></button>
                {{/each}}
            </div>
            <div class="hero-badge">
                <span class="hero-badge-icon">{{> icon name="paleta"}}</span>
                <div><strong>A domicílio</strong><small>e no seu evento</small></div>
            </div>
        </div>
    </div>
    <div class="paint-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
</section>

<!-- MODALIDADES -->
<section class="section reveal" id="oficinas">
    <div class="container">
        <span class="eyebrow">O que oferecemos</span>
        <h2 class="section-title">Do jeito que for melhor para sua família</h2>
        <div class="card-grid">
            {{#each site.oficinas}}
            <article class="service-card color-{{cor}}{{#if foto}} has-photo{{/if}}">
                {{#if foto}}<img class="service-photo" src="{{foto}}" alt="{{fotoAlt}}" loading="lazy">{{/if}}
                <span class="service-icon">{{> icon name=icone}}</span>
                <h3>{{titulo}}</h3>
                <p>{{resumo}}</p>
                <a href="/oficinas#{{id}}" class="card-link">Saiba mais <i class='bx bx-right-arrow-alt'></i></a>
            </article>
            {{/each}}
        </div>
    </div>
</section>

<!-- TEMAS -->
<section class="section section-soft reveal">
    <div class="container">
        <span class="eyebrow">Já criamos juntos</span>
        <h2 class="section-title">Do papelão à imaginação</h2>
        <p class="section-sub">Materiais simples viram grandes possibilidades criativas. Alguns temas que já passaram pelas nossas oficinas:</p>
        {{> temas}}
        <div class="section-actions">
            <a href="/portfolio" class="btn btn-primary"><i class='bx bx-images'></i> Ver portfólio completo</a>
        </div>
    </div>
</section>

<!-- BENEFÍCIOS -->
<section class="section reveal">
    <div class="container split">
        <div class="split-images">
            <img src="/images/portfolio/colagem.jpg" alt="Menina segurando o quadro de colagem com casa, árvores e flores que criou" class="img-tilt-left" loading="lazy">
            <img src="/images/portfolio/sensorial-laranja.jpg" alt="Bebê explorando rodelas de laranja na água com uma colher" class="img-tilt-right" loading="lazy">
        </div>
        <div>
            <span class="eyebrow">Por que arte?</span>
            <h2 class="section-title">Arte que ajuda a crescer</h2>
            <p class="section-sub">Quando a criança cria, ela desenvolve muito mais do que um desenho bonito.</p>
            <ul class="benefit-list">
                {{#each site.beneficios}}
                <li class="color-{{cor}}">
                    <span class="benefit-dot"></span>
                    <div>
                        <h3>{{titulo}}</h3>
                        <p>{{texto}}</p>
                    </div>
                </li>
                {{/each}}
            </ul>
        </div>
    </div>
</section>

<!-- QUEM SOU EU -->
<section class="section section-soft reveal">
    <div class="container about-teaser">
        <div class="avatar-circle has-photo avatar-luh"><img src="/images/portfolio/luh-oficina.jpg" alt="A Luh, criadora da NeuroArte, com o avental da marca e o bicho-preguiça mascote das oficinas" loading="lazy"></div>
        <div>
            <span class="eyebrow">Quem sou eu?</span>
            <h2 class="section-title">Oi, eu sou a {{site.responsavel}}!</h2>
            <p class="section-sub">Sou arte educadora, com {{site.anosEducacao}} anos na educação, e uso recursos artísticos para estimular as funções cognitivas das crianças. Não estou brincando de fazer arte: para mim, arte é coisa séria, e existe muito estudo por trás de cada atividade.</p>
            <a href="/sobre" class="btn btn-outline">Conheça minha história</a>
        </div>
    </div>
</section>

{{> feedbacks}}

<!-- FESTAS -->
<section class="section section-soft reveal">
    <div class="container about-teaser">
        <div class="avatar-circle has-photo"><img src="/images/portfolio/festa-cavaletes.jpg" alt="Mesa de pintura com cavaletes montada no jardim para uma festa" loading="lazy"></div>
        <div>
            <span class="eyebrow">Aniversário chegando?</span>
            <h2 class="section-title">Leve a oficina para a festa</h2>
            <p class="section-sub">Um espaço de arte com o tema da festa, onde as crianças criam, brincam e levam a obra para casa como lembrancinha.</p>
            <a href="/festas-infantis" class="btn btn-primary">Ver oficina para festas</a>
        </div>
    </div>
</section>

{{> faq}}

{{> cta}}
